---
// 访问不存在的地址时使用：保留站点外观，只显示一行提示。
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="ZHUANG.WENDI - Page Not Found" description="Page not found" themeColor="#ffffff">
  <SiteHeader />

  <main class="multilingual">
    <p class="notfound">
      Page not found. <a href="/">Go to home</a>
    </p>
  </main>

  <SiteFooter />
</BaseLayout>

<style is:global>
  .notfound {
    padding: 6rem 0 12rem;
  }
  .notfound a {
    color: inherit;
    text-decoration: underline;
  }
</style>
