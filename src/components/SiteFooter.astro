---
// 页面里显示的年份以建站时间为准。
const year = new Date().getFullYear();
---

<footer class="multilingual">
  <div class="footer-container multilingual">
    <p>&copy; <span data-year>{year}</span> ZHUANG.WENDI. ALL RIGHTS RESERVED.</p>
  </div>
</footer>

<script is:inline>
  // 跨年之后若还没重新构建，直接按访问者本地年份纠正。
  // 为了保留文字包裹（ml-num），有内层元素时只改内层文字。
  (function () {
    var el = document.querySelector('[data-year]');
    if (!el) return;
    var target = el.querySelector('[class^="ml-"]') || el;
    var now = String(new Date().getFullYear());
    if (target.textContent.trim() !== now) target.textContent = now;
  })();
</script>
